{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "WebOrigin": "https://localhost:7100"
  },
  "Jwt": {
    "Issuer": "nextgen-coaching",
    "Audience": "nextgen-coaching-web",
    "Secret": "",
    "AccessTokenMinutes": "30"
  },
  "Email": {
    "_comment": "SMTP settings are DB-driven (dedicated email_settings table), managed at /admin/settings/email. This section is intentionally empty and is not read at runtime."
  },
  "Storage": {
    "LocalRoot": "",
    "PublicBaseUrl": "/uploads"
  },
  "Razorpay": {
    "KeyId": "",
    "KeySecret": "",
    "WebhookSecret": "",
    "ApiBaseUrl": "https://api.razorpay.com/v1",
    "Currency": "INR"
  },
  "Seed": {
    "AdminEmail": "admin@nextgencoaching.local",
    "AdminPassword": "",
    "IncludeDemoData": false
  },
  "Captcha": {
    "Enabled": false,
    "Provider": "turnstile",
    "SiteKey": "",
    "SecretKey": "",
    "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  }
}
