<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NextGenCoaching.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NextGenCoaching.Shared\NextGenCoaching.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      NOTE: EFCore.NamingConventions 10.0.0 transitively requires EntityFrameworkCore >= 10.0.1
      so we pin EF Core packages to 10.0.1 to keep the constraint satisfied without an NU1605 downgrade.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.0" />

    <!-- Identity + JWT bumped to match JwtBearer's transitive OpenIdConnect 8.0.1 chain -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />

    <!-- Extensions abstractions bumped to 10.0.1 to match Identity's transitive chain -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />

    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />

    <!-- MailKit / MimeKit bumped past the known advisories GHSA-9j88-vvj5-vhgr and GHSA-g7hc-96xr-gvvx.
         MimeKit comes in transitively via MailKit, so bumping MailKit is enough. -->
    <PackageReference Include="MailKit" Version="4.13.0" />

    <!-- Invoice PDF generation. Community licence covers us until $1M annual revenue. -->
    <PackageReference Include="QuestPDF" Version="2024.10.3" />

    <!-- Explicit override of the vulnerable transitive (advisories GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf).
         9.0.0 has known issues; pinning the 10.x line picks up the patched build. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.0" />
  </ItemGroup>
</Project>
