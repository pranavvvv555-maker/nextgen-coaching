@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@inject IConfiguration Configuration
@inject AssetVersions AssetVersions
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <script src="@PreferencesScriptUrl"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Learn Data Science, AI and cloud technologies with NextGen through practical projects, mentor guidance and live online classes across India." />
    <meta name="theme-color" content="#14213b" />
    <meta name="robots" content="@(Configuration.GetValue<bool>("Site:Indexable") ? "index, follow" : "noindex, nofollow")" />
    <base href="/" />
    <link rel="icon" type="image/jpeg" href="images/nextgen-official-logo.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@StylesheetUrl" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>
<body>
    <SitePreferencesProvider @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.web.js"></script>
    <script src="@AssetVersions.Url("js/confetti.browser.min.js")" defer></script>
    <script src="@AssetVersions.Url("js/vendor/motion-14.1.0.js")" defer></script>
    <script src="@MotionScriptUrl" defer></script>
    <script src="@AssetVersions.Url("js/razorpay-interop.js")" defer></script>
    @if (HostingEnvironment.IsDevelopment() && HttpContextAccessor.HttpContext?.Request.Query.ContainsKey("perf") == true)
    {
        <script src="@AssetVersions.Url("js/performance-probe.js")" defer></script>
    }
</body>
</html>



@code {
    private string PreferencesScriptUrl => AssetVersions.Url("js/site-preferences.js");
    private string MotionScriptUrl => AssetVersions.Url("js/nextgen-motion.js");
    private string StylesheetUrl => AssetVersions.Url("css/app.output.css");
}

