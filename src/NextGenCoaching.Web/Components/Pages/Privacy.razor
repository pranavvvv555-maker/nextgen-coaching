@page "/privacy"

<PageTitle>@L["Privacy Policy · NextGen Coaching"]</PageTitle>

<PageIntro Eyebrow="CLARITY &amp; TRUST" Title="Your privacy matters." Description="How we collect, use, and safeguard your personal information throughout your NextGen experience." Meta="@LastUpdated" />

<section class="max-w-3xl mx-auto px-4 py-12 space-y-8">

    <div>
        <p class="text-text-secondary">
            @L["This Privacy Policy explains how NextGen Graduate IT Coaching (\"NextGen\", \"we\", \"us\") collects, uses, discloses, and safeguards your information when you visit our website, register for a webinar, create an account, or enrol in a programme. We are committed to handling your data in accordance with the Digital Personal Data Protection Act, 2023 (DPDP Act) and other applicable Indian law."]
        </p>
    </div>

    <div>
        <h2 class="text-h2 mb-3">@L["Information we collect"]</h2>
        <p class="text-text-secondary mb-2">@L["We collect the following categories of personal data:"]</p>
        <ul class="list-disc pl-6 text-text-secondary space-y-1">
            <li><span class="font-medium text-text-primary">@L["Identity & contact data"]</span> @L["— name, email address, phone number, and city, provided when you sign up, register for a webinar, or submit an enquiry."]</li>
            <li><span class="font-medium text-text-primary">@L["Account data"]</span> @L["— your login credentials (passwords are stored only as salted hashes) and role."]</li>
            <li><span class="font-medium text-text-primary">@L["Education & career data"]</span> @L["— your academic background, career goals, resume, and social/professional links, where you choose to provide them."]</li>
            <li><span class="font-medium text-text-primary">@L["Learning data"]</span> @L["— enrolments, attendance, assignment and project submissions, grades, and feedback."]</li>
            <li><span class="font-medium text-text-primary">@L["Payment data"]</span> @L["— transaction records and invoices. Card and banking details are processed directly by our payment gateway (Razorpay) and are not stored on our servers."]</li>
            <li><span class="font-medium text-text-primary">@L["Technical data"]</span> @L["— limited log and device information used to operate and secure the platform."]</li>
        </ul>
    </div>

    <div>
        <h2 class="text-h2 mb-3">@L["How we use your data"]</h2>
        <p class="text-text-secondary mb-2">@L["We use your personal data to:"]</p>
        <ul class="list-disc pl-6 text-text-secondary space-y-1">
            <li>@L["deliver our coaching programmes, including sessions, grading, and placement support;"]</li>
            <li>@L["process payments and issue invoices;"]</li>
            <li>@L["communicate with you about your account, enrolments, webinars, and support requests;"]</li>
            <li>@L["share opportunities with hiring partners as part of placement assistance, where you have opted in;"]</li>
            <li>@L["improve our services and maintain the security of the platform; and"]</li>
            <li>@L["comply with our legal obligations."]</li>
        </ul>
    </div>

    <div>
        <h2 class="text-h2 mb-3">@L["Sharing your data"]</h2>
        <p class="text-text-secondary">
            @L["We do not sell your personal data. We share it only with service providers who help us run the platform (such as our payment gateway, email provider, and hosting partners) under appropriate confidentiality obligations, and with hiring partners during placement assistance where you have consented. We may disclose data where required by law."]
        </p>
    </div>

    <div>
        <h2 class="text-h2 mb-3">@L["Data retention"]</h2>
        <p class="text-text-secondary">
            @L["We retain your personal data for as long as your account is active and for a reasonable period afterwards to meet legal, accounting, and placement-support requirements. You may request deletion of your account, subject to records we are required to keep."]
        </p>
    </div>

    <div>
        <h2 class="text-h2 mb-3">@L["Your rights"]</h2>
        <p class="text-text-secondary mb-2">@L["Under the DPDP Act, you have the right to:"]</p>
        <ul class="list-disc pl-6 text-text-secondary space-y-1">
            <li>@L["access and obtain a summary of the personal data we hold about you;"]</li>
            <li>@L["request correction or updating of inaccurate or incomplete data;"]</li>
            <li>@L["request erasure of your personal data;"]</li>
            <li>@L["withdraw consent at any time, where processing is based on consent; and"]</li>
            <li>@L["nominate another individual to exercise your rights in the event of death or incapacity."]</li>
        </ul>
        <p class="text-text-secondary mt-2">
            @L["To exercise any of these rights, contact us using the details below."]
        </p>
    </div>

    <div>
        <h2 class="text-h2 mb-3">@L["Security"]</h2>
        <p class="text-text-secondary">
            @L["We apply reasonable technical and organisational measures to protect your data, including encrypted transport, hashed passwords, and role-based access controls. No method of transmission or storage is completely secure, and we cannot guarantee absolute security."]
        </p>
    </div>

    <div>
        <h2 class="text-h2 mb-3">@L["Children"]</h2>
        <p class="text-text-secondary">
            @L["Our programmes are intended for graduates. We do not knowingly collect personal data from children in a manner that requires verifiable parental consent under applicable law. If you believe a child has provided us data, please contact us so we can address it."]
        </p>
    </div>

    <div>
        <h2 class="text-h2 mb-3">@L["Changes to this policy"]</h2>
        <p class="text-text-secondary">
            @L["We may update this Privacy Policy from time to time. Material changes will be reflected by updating the \"Last updated\" date above and, where appropriate, by notifying you."]
        </p>
    </div>

    <div class="card p-6">
        <h2 class="text-h2 mb-3">@L["Contact us"]</h2>
        <p class="text-text-secondary">
            @L["For any privacy questions or to exercise your rights, contact our Grievance Officer at"]
            <a class="text-brand-primary hover:underline" href="mailto:privacy@nextgencoaching.example">privacy@nextgencoaching.example</a>@L[", or reach us via our"] <a class="text-brand-primary hover:underline" href="/contact">@L["contact page"]</a>.
        </p>
    </div>

    <p class="text-caption text-text-muted">
        @L["This page is a starting template and should be reviewed by qualified legal counsel before public launch. Replace contact details, retention periods, and the \"Last updated\" date with your finalised values."]
    </p>

</section>

@code {
    private const string LastUpdated = "27 June 2026";
}

