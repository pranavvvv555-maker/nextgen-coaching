@page "/services"

<PageTitle>@L["Student Employability & Career-Readiness Services · NextGen Coaching"]</PageTitle>

<section class="career-hero ng-hero" data-career-hero aria-labelledby="career-hero-title">
    <div class="career-hero-glow" aria-hidden="true"></div>
    <div class="ng-container career-hero-layout">
        <div class="career-hero-copy">
            <span class="career-hero-eyebrow" data-hero-enter><i aria-hidden="true"></i> @L["NEXTGEN CAREER SUPPORT"]</span>
            <h1 id="career-hero-title" data-hero-enter>@L["Skills open doors."]<br /><span>@L["Confidence takes"] <br />@L["you through."]</span></h1>
            <p data-hero-enter>@L["Big ambitions deserve people in your corner. Build your skills, find your direction and prepare for your next opportunity with NextGen."]</p>
            <div class="career-hero-actions" data-hero-enter>
                <a href="/services#career-support" class="btn-primary" data-hero-hover>@L["Explore career support"] <span aria-hidden="true">↗</span></a>
                <a href="/contact" class="career-hero-contact" data-hero-hover>@L["Talk to an advisor"] <span aria-hidden="true">↗</span></a>
            </div>
            <div class="career-hero-proof" data-hero-enter>
                <span class="career-hero-proof-icon" aria-hidden="true">✦</span>
                <span><strong>@L["Personal guidance. Practical progress."]</strong><small>@L["From your first project to your next interview."]</small></span>
            </div>
        </div>
        <div class="career-hero-scene">
            <div class="career-hero-orbit" aria-hidden="true"></div>
            <svg class="career-hero-path" viewBox="0 0 600 500" fill="none" aria-hidden="true"><path d="M60 380C-40 180 340 440 450 190S610 20 540 70" stroke="#b7c8ec" stroke-width="2" stroke-dasharray="5 8" /></svg>
            <div class="career-hero-main-enter" data-hero-enter>
                <figure class="career-hero-main-card" data-hero-float="8">
                    <ResponsiveImage Source="images/career/career-progress.jpg" Alt="@L["A student climbing learning milestones towards a career goal, supported by a coach and a skills dashboard."]" Width="2752" Height="1536" Priority="true" Sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 900px) 560px, (max-width: 1199px) 50vw, 680px" />
                    <figcaption class="sr-only">@L["Your future, moving forward."]</figcaption>
                </figure>
            </div>
            <div class="career-hero-mentor-enter" data-hero-enter>
                <figure class="career-hero-mentor-card" data-hero-float="5">
                    <ResponsiveImage Source="images/career/industry-mentorship.jpg" Alt="@L["An experienced engineer helping a junior developer plan his next steps."]" Width="2752" Height="1536" Sizes="(max-width: 767px) 180px, 320px" />
                    <figcaption><i aria-hidden="true"></i> @L["A mentor in your corner."]</figcaption>
                </figure>
            </div>
            <div class="career-hero-plan-enter" data-hero-enter>
                <div class="career-hero-plan" data-hero-float="6"><span aria-hidden="true">✓</span><div><small>@L["YOUR NEXT CHAPTER"]</small><strong>@L["Starts with a plan."]</strong></div></div>
            </div>
            <div class="career-hero-count-enter" data-hero-enter>
                <a href="/services#career-support" class="career-hero-count" data-hero-hover><strong>@AllServices.Length</strong><span>@L["ways to grow"]<br /><small>@L["Explore your support ↗"]</small></span></a>
            </div>
            <span class="career-hero-spark" data-hero-float="7" aria-hidden="true">✳</span>
        </div>
    </div>
    <div class="ng-container career-hero-footer"><span>@L["YOUR AMBITION. YOUR JOURNEY. NEXTGEN."]</span><a href="/services#career-support">@L["Discover what comes next"] <span aria-hidden="true">↓</span></a></div>
</section>
<!-- Twelve distinct career support services -->
<section id="career-support" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16" data-motion="fade-up">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-semibold uppercase tracking-wider mb-3">
            @L["The Complete Framework"]
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            @L["12 ways to build your career confidence."]
        </h2>
        <p class="mt-4 text-base text-slate-600 leading-relaxed">
            @L["Build a stronger profile, sharpen your skills and prepare for your next opportunity. Each service has a clear purpose and practical steps you can work towards."]
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-2" role="group" aria-label="@L["Filter career support services"]">
            @foreach (var category in Categories)
            {
                <button @onclick="() => FilterCategory(category.Id)"
                        aria-pressed="@(_activeCategory == category.Id ? "true" : "false")"
                        class="px-4 py-2 rounded-xl text-xs font-bold transition-all @(_activeCategory == category.Id ? "bg-slate-900 text-white shadow-md" : "bg-slate-100 hover:bg-slate-200 text-slate-700")">
                    @CategoryFilterLabel(category)
                </button>
            }
        </div>
    </div>

    <!-- Matching artwork and specific deliverables for every service -->
    <div class="career-services-grid">
        @foreach (var s in FilteredServices)
        {
            <article @key="s.Id" data-motion="fade-up" class="career-service-card" data-service-id="@s.Id">
                <div class="career-service-image">
                    <ResponsiveImage Source="@($"images/career/{s.ImageFile}")" Alt="@s.ImageAlt" Width="2752" Height="1536" Sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) 46vw, 430px" />
                </div>
                <div class="career-service-content">
                    <div class="career-service-heading">
                        <span class="career-service-number" aria-hidden="true">@int.Parse(s.Id).ToString("00")</span>
                        <span class="career-service-category @s.BadgeStyle">@L[s.CategoryLabel]</span>
                    </div>
                    <h3>@L[s.Title]</h3>
                    <p class="career-service-description">@L[s.Description]</p>
                    <ul class="career-service-deliverables" aria-label="@L["What you will work on"]">
                        @foreach (var d in s.Deliverables)
                        {
                            <li><span aria-hidden="true">✓</span><span>@L[d]</span></li>
                        }
                    </ul>
                    <div class="career-service-outcome">
                        <span>@L["Outcome focus"]</span>
                        <strong>@L[s.OutcomeTag]</strong>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<!-- COMPARISON BANNER -->
<section class="py-20 bg-slate-900 text-white relative overflow-hidden">
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-96 h-96 bg-brand-primary/20 rounded-full blur-[120px]"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center" data-motion="fade-up">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">@L["Your next move starts with a clear plan."]</h2>
        <p class="mt-4 text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
            @L["Get practical support across your profile, projects and interview preparation. Talk to us about your goals, your current skills and the next step that suits you."]
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-4">
            <a href="/contact" class="btn-gradient px-8 py-3.5 text-base shadow-glow-cyan">@L["Inquire for Your College or Cohort"]</a>
            <a href="/webinar" class="btn-glass px-8 py-3.5 text-base">@L["Watch Free Demo Class"]</a>
        </div>
    </div>
</section>

@code {
    private string _activeCategory = "all";
    private void FilterCategory(string category) => _activeCategory = category;

    private record ServiceCategory(string Id, string Label);
    private static readonly ServiceCategory[] Categories =
    {
        new("all", "All Services"),
        new("interview", "Interviews & Careers"),
        new("tech", "Projects & Practice"),
        new("soft", "Professional Skills"),
        new("mentorship", "Mentorship & Progress")
    };

    private string CategoryFilterLabel(ServiceCategory category)
    {
        var count = category.Id == "all" ? AllServices.Length : AllServices.Count(s => s.Category == category.Id);
        return category.Id == "all" ? L.Format("All {0} Services", count) : $"{L[category.Label]} ({count})";
    }

    private record ServiceItem(
        string Id, string Category, string CategoryLabel, string BadgeStyle,
        string Title, string Description, string[] Deliverables, string OutcomeTag,
        string ImageFile, string ImageAlt
