<!-- OUR MISSION & THE INDUSTRY DILEMMA -->
<section id="our-approach" class="about-section about-approach">
    <div class="about-approach-grid">
        <div class="about-approach-copy" data-motion="fade-up">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-semibold uppercase tracking-wider mb-3">
                @L["The Reality of Tech Hiring"]
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight leading-tight">
                @L["Why standard college degrees fail the modern data and cloud test."]
            </h2>
            <p class="mt-4 text-base text-slate-600 leading-relaxed">
                @L["Every year, hundreds of thousands of bright graduates enter the job market with degrees in Computer Science, IT, Commerce, and Engineering. Yet, hiring managers struggle to fill entry-level analytics and cloud engineering desks."]
            </p>
            <p class="mt-3 text-base text-slate-600 leading-relaxed">
                @L["The problem isn't intelligence — it's"] <strong class="text-slate-900 font-semibold">@L["production disconnect"]</strong>@L[". University syllabi teach toy SQL queries and 10-year-old textbooks. Today’s high-paying employers demand live Snowflake data warehouses, automated Azure Data Factory pipelines, production Git branching, and business-focused Power BI storytelling."]
            </p>

            <div class="mt-6 space-y-3">
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
                    <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">✓</div>
                    <div>
                        <h4 class="text-sm font-semibold text-slate-900">@L["Zero Toy Projects"]</h4>
                        <p class="text-xs text-slate-500 mt-0.5">@L["We don't do generic Iris or Titanic datasets. You build enterprise e-commerce churn pipelines and fintech credit risk models."]</p>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
                    <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">✓</div>
                    <div>
                        <h4 class="text-sm font-semibold text-slate-900">@L["Inclusive for Non-CS Graduates"]</h4>
                        <p class="text-xs text-slate-500 mt-0.5">@L["Over 42% of our successfully placed alumni hold degrees in B.Com, B.Sc, BCA, or non-CS Engineering streams."]</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Visual Contrast Card -->
        <div data-motion="fade-up" class="about-comparison relative">
            <div class="absolute -inset-2 bg-gradient-to-r from-brand-primary to-brand-cyan rounded-3xl blur-xl opacity-30"></div>
            <div class="relative bg-slate-900 rounded-2xl p-8 border border-white/10 shadow-2xl text-white">
                <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-brand-cyan animate-pulse"></span>
                    @L["Academia vs. NextGen Accelerator"]
                </h3>

                <div class="space-y-4">
                    <div class="p-4 rounded-xl bg-white/5 border border-white/10">
                        <div class="text-xs font-semibold text-rose-400 uppercase tracking-wider mb-1">@L["Traditional College"]</div>
                        <div class="text-sm text-slate-300">@L["Pen-and-paper theoretical exams, outdated C/C++ or basic Java, no version control, and passive campus placement pools."]</div>
                    </div>

                    <div class="p-4 rounded-xl bg-gradient-to-r from-brand-primary/20 to-brand-cyan/15 border border-brand-cyan/40">
                        <div class="text-xs font-semibold text-brand-cyan uppercase tracking-wider mb-1">@L["The NextGen Ecosystem"]</div>
                        <div class="text-sm text-white font-medium">
                            @L["Live weekend war rooms, code reviews on GitHub, cloud deployments on AWS/Azure, AI-assisted portfolio creation, and 1-on-1 mock interviews until you're placed."]
                        </div>
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
                    <span>@L["Average time to first offer:"]</span>
                    <span class="font-bold text-brand-cyan text-sm">@L["4.2 Months"]</span>
                </div>
            </div>
        </div>
    </div>
</section>

