@page "/courses/{Slug}"
@inject CourseApiClient Courses
@inject NavigationManager Nav

<PageTitle>@L[_course?.Title ?? "Course Details"] · NextGen Graduate IT Coaching</PageTitle>

<div class="course-details-page">

@if (_loading)
{
    <div class="max-w-7xl mx-auto px-4 py-24 text-center">
        <div class="inline-block w-10 h-10 border-4 border-brand-primary border-t-transparent rounded-full animate-spin mb-4"></div>
        <p class="text-sm font-semibold text-text-secondary">@L["Loading program details…"]</p>
    </div>
}
else if (_course is null)
{
    <div class="max-w-7xl mx-auto px-4 py-24 text-center">
        <div class="text-4xl mb-4">📚</div>
        <h1 class="text-2xl font-bold text-brand-navy mb-2">@L["Program not found"]</h1>
        <p class="text-sm text-text-secondary mb-6">@L["The course you are looking for may have been moved or updated."]</p>
        <a href="/courses" class="btn-primary">@L["Browse All Courses →"]</a>
    </div>
}
else
{
    @* ============================================================ *@
    @* HERO BANNER                                                  *@
    @* ============================================================ *@
    <section class="bg-gradient-to-b from-brand-navy-dark via-brand-navy to-brand-navy-light text-white py-14 md:py-20 relative overflow-hidden">
        <div class="absolute -top-20 -right-20 w-96 h-96 bg-brand-primary/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 relative z-10 grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-8 space-y-4" data-motion="fade-up">
                @* Breadcrumb *@
                <div class="course-breadcrumb flex items-center gap-2 text-xs text-brand-sky-200">
                    <a href="/" class="hover:underline">@L["Home"]</a>
                    <span>/</span>
                    <a href="/courses" class="hover:underline">@L["Courses"]</a>
                    <span>/</span>
                    <span class="text-white font-medium">@L[_course.Title]</span>
                </div>

                <div class="flex flex-wrap items-center gap-2 pt-1">
                    @if (_course.IsFlagship)
                    {
                        <span class="pill-flagship">@L["★ Flagship Program"]</span>
                    }
                    @if (!string.IsNullOrEmpty(_course.Category))
                    {
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white/10 text-brand-sky-100 uppercase tracking-wide">@L[_course.Category]</span>
                    }
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">@L["100% Placement Support"]</span>
                </div>

                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
                    @L[_course.Title]
                </h1>

                <p class="text-base sm:text-lg text-brand-sky-100/90 max-w-2xl leading-relaxed">
                    @L[_course.Tagline]
                </p>

                @* Quick Highlights *@
                <div class="flex flex-wrap gap-4 pt-3 text-xs text-white/80 font-medium">
                    <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg">
                        <span>⏱️</span>
                        <span>@(_course.DurationMonths > 0 ? L.Format(_course.DurationMonths == 1 ? "{0} Month Intensive" : "{0} Months Intensive", _course.DurationMonths) : L.Format("{0} Hours", _course.TotalHours ?? 60))</span>
                    </div>
                    <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg">
                        <span>🎓</span>
                        <span class="capitalize">@L.Format("{0} Level", L[_course.Level])</span>
                    </div>
                    <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg">
                        <span>💻</span>
                        <span class="capitalize">@L.Format("{0} Training", L[_course.Mode.Replace("-", " ")])</span>
                    </div>
                    <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg">
                        <span>⭐</span>
                        <span>@L["4.9 / 5 (350+ Reviews)"]</span>
                    </div>
                </div>
            </div>

            @* Quick Card on Mobile / Tablet *@
            <div class="lg:col-span-4" data-motion="scale-up" data-delay="100">
                <div class="card p-6 md:p-8 bg-surface shadow-2xl border-border-base relative rounded-3xl">
                    <div class="text-xs font-bold uppercase tracking-wider text-text-muted mb-3">@L["YOUR NEXT CHAPTER"]</div>
                    <h2 class="text-2xl font-bold text-brand-navy mb-3">@L["Ready to get started?"]</h2>
                    <p class="text-sm text-text-secondary leading-relaxed mb-6">@L["Complete the enrollment form and our admissions team will guide you through the next steps."]</p>

                    <div class="space-y-2.5">
                        <a href="@($"/enroll?course={_course.Slug}")" class="btn-gradient w-full text-center py-3.5 text-sm shadow-glow-blue font-bold">
                            @L["Enroll Now"] <span aria-hidden="true">→</span>
                        </a>
                        <a href="/webinar" class="btn-outline w-full text-center py-2.5 text-xs font-bold">
                            @L["Attend Free Demo Class First"]
                        </a>
                        <a href="/contact" class="btn bg-surface-muted hover:bg-border-base/50 text-text-secondary w-full text-center py-2.5 text-xs">
                            @L["Speak with Course Counsellor"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ============================================================ *@
    @* COURSE OVERVIEW & ABOUT                                      *@
    @* ============================================================ *@
    @if (_course.Description is not null)
    {
        <section class="max-w-7xl mx-auto px-4 py-16">
            <div class="max-w-3xl space-y-4" data-motion="fade-up">
                <span class="pill bg-brand-sky-100 text-brand-primary-dark">@L["Course Overview"]</span>
                <h2 class="text-2xl md:text-3xl font-extrabold text-brand-navy">@L["What You Will Achieve"]</h2>
                <p class="text-sm md:text-base text-text-secondary leading-relaxed">
                    @L[_course.Description]
                </p>
            </div>
        </section>
    }

    @* ============================================================ *@
    @* TOOLS YOU'LL MASTER                                          *@
    @* ============================================================ *@
    @if (_course.Tools.Count > 0)
    {
        <section class="bg-surface-muted py-16 border-y border-border-base">
            <div class="max-w-7xl mx-auto px-4">
                <div class="mb-10" data-motion="fade-up">
                    <span class="pill bg-brand-sky-100 text-brand-primary-dark mb-2">@L["Tech Stack"]</span>
                    <h2 class="text-2xl md:text-3xl font-extrabold text-brand-navy">@L["Technologies & Tools You'll Master"]</h2>
                    <p class="text-xs md:text-sm text-text-secondary mt-1">@L["Deep practical exposure with enterprise toolchains."]</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
                    @foreach (var t in _course.Tools)
                    {
                        <div class="card p-6 text-center hover:shadow-card-hover transition-all border-border-base group" data-motion="fade-up">
                            <div class="w-12 h-12 rounded-2xl bg-brand-sky-50 text-brand-primary flex items-center justify-center font-bold text-lg mx-auto mb-3 group-hover:scale-110 transition-transform">
                                ⚡
                            </div>
                            <div class="font-bold text-base text-brand-navy group-hover:text-brand-primary transition-colors">@t.ToolName</div>
                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <div class="text-xs text-text-secondary mt-1.5 leading-relaxed">@L[t.Description]</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @* ============================================================ *@
    @* 12-STEP LEARNING ROADMAP                                      *@
    @* ============================================================ *@
    @if (_course.JourneySteps.Count > 0)
    {
        <section class="max-w-7xl mx-auto px-4 py-16 md:py-24">
            <div class="mb-12" data-motion="fade-up">
                <span class="pill bg-brand-sky-100 text-brand-primary-dark mb-2">@L["Curriculum Roadmap"]</span>
                <h2 class="text-2xl md:text-3xl font-extrabold text-brand-navy">@L["Structured Step-by-Step Curriculum"]</h2>
                <p class="text-xs md:text-sm text-text-secondary mt-1">@L["From initial bootcamp orientation to live corporate interviews."]</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                @foreach (var s in _course.JourneySteps)
                {
                    <JourneyStepCard StepNumber="s.StepNumber" Title="@s.Title" Description="@s.Description" />
                }
            </div>
        </section>
    }

    @* ============================================================ *@
    @* WHAT'S INCLUDED IN THIS PROGRAM                              *@
    @* ============================================================ *@
    @if (_course.Features.Count > 0)
    {
        <section class="bg-surface-muted py-16 border-t border-border-base">
            <div class="max-w-7xl mx-auto px-4">
                <div class="mb-10" data-motion="fade-up">
                    <span class="pill bg-brand-sky-100 text-brand-primary-dark mb-2">@L["Program Inclusions"]</span>
                    <h2 class="text-2xl md:text-3xl font-extrabold text-brand-navy">@L["Everything Included in Your Enrollment"]</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
                    @foreach (var f in _course.Features)
                    {
                        <div class="card p-5 flex items-center gap-4 bg-surface hover:shadow-card-hover transition-all" data-motion="fade-up">
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-base shadow-sm">
                                ✓
                            </div>
                            <div class="font-bold text-sm text-brand-navy">@L[f.Label]</div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}

</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private CourseDetailDto? _course;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _course = await Courses.GetCourseAsync(Slug);
        _loading = false;
    }
}
