@page "/set-password"
@inject ApiClient Api
@inject AuthApiClient AuthApi
@inject NavigationManager Nav

<PageTitle>@L["Set your password · NextGen"]</PageTitle>

<section class="min-h-[calc(100vh-200px)] bg-surface-muted flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
        <div class="card p-8">
            <div class="mb-6"><BrandLogo /></div>
            <h1 class="text-h2 mb-1">@L["Set your password"]</h1>
            <p class="text-caption text-text-secondary mb-6">@L["Choose a password to activate your NextGen student account."]</p>

            @if (_done)
            {
                <div class="text-center">
                    <div class="w-12 h-12 rounded-full bg-status-success/15 text-status-success flex items-center justify-center mx-auto mb-4 text-2xl">✓</div>
                    <p class="text-text-secondary mb-4">@L["Password set. You can sign in now."]</p>
                    <a href="/login" class="btn-primary inline-block">@L["Go to sign-in"]</a>
                </div>
            }
            else if (UserId is null || string.IsNullOrEmpty(Token))
            {
                <div class="text-sm text-status-danger bg-status-danger/10 rounded-btn p-2.5">
                    @L["This link is invalid or expired. Ask your counsellor to re-send."]
                </div>
            }
            else
            {
                <div class="space-y-3">
                    <div>
                        <label class="text-caption text-text-secondary mb-1 block">@L["New password"]</label>
                        <input @bind="_password" type="password" autocomplete="new-password"
                               class="w-full border border-border-base rounded-btn px-3 py-2.5 text-sm" />
                        <div class="text-meta text-text-muted mt-1">@L["Min 8 characters, at least one digit and one uppercase letter."]</div>
                    </div>
                    <div>
                        <label class="text-caption text-text-secondary mb-1 block">@L["Confirm password"]</label>
                        <input @bind="_confirm" type="password" autocomplete="new-password"
                               class="w-full border border-border-base rounded-btn px-3 py-2.5 text-sm" />
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="text-sm text-status-danger bg-status-danger/10 rounded-btn p-2.5">@L[_error]</div>
                    }

                    <button @onclick="SubmitAsync" disabled="@(_busy || !CanSubmit)" class="btn-primary w-full mt-1">
                        @L[_busy ? "Setting password…" : "Set password"]
                    </button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, SupplyParameterFromQuery] public Guid? UserId { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Token { get; set; }

    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private bool _busy;
    private bool _done;
    private string? _error;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_password)
        && _password == _confirm;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        if (_password != _confirm)
        {
            _error = "Passwords don't match.";
            _busy = false;
            return;
        }

        var resp = await Api.PostAsync<object, object>(
            NextGenCoaching.Shared.Constants.ApiRoutes.Auth.ResetPassword,
            new { userId = UserId, token = Token, newPassword = _password });

        _busy = false;
        if (resp?.Success == true)
            _done = true;
        else
            _error = resp?.Message ?? "Could not set password. The link may have expired.";
    }
}

