@page "/blog"
<PageTitle>@L["Learning guides · NextGen"]</PageTitle>
<section class="ng-container guides-page">
    <span class="eyebrow">NEXTGEN · @L["Learning resources"]</span>
    <h1>@L["Small insights. Stronger foundations."]</h1>
    <p>@L["Explore practical starting points for your learning journey."]</p>
    <div class="guides-grid">
        @foreach (var guide in Guides)
        {
            <details class="guide-card"><summary><ContactGlyph Name="@guide.Icon" /><h2>@L[guide.Title]</h2><span>@L["Read guide"] <span aria-hidden="true">＋</span></span></summary><div><p>@L[guide.Body]</p><a href="/courses/@guide.Slug" class="text-link">@L["View program"] →</a></div></details>
        }
    </div>
    <a href="/contact" class="btn-primary">@L["Talk to an advisor"]</a>
</section>
@code {
    private record Guide(string Icon, string Title, string Body, string Slug);
    private readonly Guide[] Guides = [
        new("database", "Start with SQL", "Practise filtering, grouping and joining tables. Compare a window function with GROUP BY, and explain which question each query answers.", "sql"),
        new("code", "Build confidence with Python", "Start with functions, lists and dictionaries. Read a small dataset with Pandas, handle missing values and document the decisions you make.", "python"),
        new("chart", "Tell a clear story with data", "Choose one business question, define the metric and check your source data. Build a chart that answers the question and explain its limitations.", "power-bi"),
        new("cloud", "Understand cloud data workflows", "Trace how data moves from a source into storage and reporting. Think about schedules, failed runs, access permissions and how you would monitor the pipeline.", "azure-data-factory"),
        new("spark", "Learn the foundations of AI", "Understand features, training and evaluation before comparing models. Keep training and test data separate, and check for leakage and unfair assumptions.", "data-science"),
        new("target", "Present your project clearly", "Explain the problem, your approach and what you learned. Include reproducible steps and describe the tradeoffs rather than listing tools alone.", "data-science")
    ];
}
