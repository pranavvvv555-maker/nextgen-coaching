@page "/Error"
@using System.Diagnostics

<PageTitle>@L["Error"]</PageTitle>

<section class="max-w-4xl mx-auto px-4 py-20 text-center">
    <h1 class="text-3xl font-semibold mb-3">@L["Something went wrong"]</h1>
    <p class="text-text-secondary">@L["An unexpected error occurred. Please try again, or go back to the home page."]</p>
    <a href="/" class="btn-primary mt-6 inline-block">@L["Back to home"]</a>
</section>
