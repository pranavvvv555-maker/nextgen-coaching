@page "/admin/payments"
@layout AdminLayout
@inject PaymentApiClient PayApi

<PageTitle>Payments · Admin · NextGen</PageTitle>

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-h2">@L["Payments"]</h1>
        <p class="text-caption text-text-secondary">All Razorpay transactions with refund + invoice actions.</p>
    </div>
</div>

@* Filters *@
<div class="card p-4 mb-4">
    <div class="flex flex-wrap gap-3 items-end">
        <div class="w-44">
            <label class="text-caption text-text-secondary mb-1 block">@L["Status"]</label>
            <select @bind="_status" class="w-full border border-border-base rounded-btn px-3 py-2 text-sm">
                <option value="">All</option>
                <option value="Created">@L["Created"]</option>
                <option value="Authorized">Authorized</option>
                <option value="Captured">Captured</option>
                <option value="Failed">Failed</option>
                <option value="Refunded">Refunded</option>
            </select>
        </div>
        <button @onclick="LoadAsync" class="btn-primary">Apply</button>
    </div>
</div>

@* Table *@
<div class="card overflow-hidden">
    @if (_data is null)
    {
        <div class="p-8 text-center text-text-muted">@L["Loading…"]</div>
    }
    else if (_data.Items.Count == 0)
    {
        <div class="p-8 text-center text-text-muted">No transactions match these filters.</div>
    }
    else
    {
        <table class="w-full text-sm">
            <thead class="bg-surface-muted">
                <tr class="text-left text-meta uppercase tracking-wider text-text-muted">
                    <th class="px-4 py-3 font-medium">Order / Payment</th>
                    <th class="px-4 py-3 font-medium">Course</th>
                    <th class="px-4 py-3 font-medium">Amount</th>
                    <th class="px-4 py-3 font-medium">@L["Status"]</th>
                    <th class="px-4 py-3 font-medium">@L["Created"]</th>
                    <th class="px-4 py-3 font-medium text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border-base">
                @foreach (var p in _data.Items)
                {
                    <tr class="hover:bg-surface-muted/50">
                        <td class="px-4 py-3">
                            <div class="font-mono text-meta">@p.ProviderOrderId</div>
                            @if (!string.IsNullOrEmpty(p.ProviderPaymentId))
                            {
                                <div class="font-mono text-meta text-text-muted">@p.ProviderPaymentId</div>
                            }
                        </td>
                        <td class="px-4 py-3 text-text-secondary">
                            <div>@(p.CourseTitle ?? "—")</div>
                            @if (!string.IsNullOrEmpty(p.BatchName))
                            {
                                <div class="text-meta text-text-muted">@p.BatchName</div>
                            }
                        </td>
                        <td class="px-4 py-3 font-medium text-brand-navy">@p.Currency @p.Amount.ToString("N0")</td>
                        <td class="px-4 py-3"><span class="@StatusPillClass(p.Status)">@p.Status</span></td>
                        <td class="px-4 py-3 text-text-muted text-caption">@p.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex gap-1 justify-end">
                                @if (p.InvoiceAvailable)
                                {
                                    <a href="@PayApi.GetAdminInvoiceUrl(p.Id)" target="_blank" class="btn-outline text-caption px-2.5 py-1">Invoice</a>
                                }
                                @if (p.Status == "Captured")
                                {
                                    <button @onclick="() => OpenRefund(p)" class="btn-outline text-caption px-2.5 py-1 hover:text-status-danger hover:border-status-danger">Refund</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* Refund modal *@
@if (_refundTarget is not null)
{
    <div class="fixed inset-0 z-40 bg-brand-navy/40" @onclick="CancelRefund"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="bg-surface rounded-card shadow-card-hover w-full max-w-md pointer-events-auto" @onclick:stopPropagation="true">
            <div class="px-5 py-4 border-b border-border-base">
                <h2 class="text-h3">Refund payment</h2>
                <p class="text-caption text-text-muted">@_refundTarget.Currency @_refundTarget.Amount.ToString("N0") for @(_refundTarget.CourseTitle ?? "—")</p>
            </div>
            <div class="p-5 space-y-3">
                <div>
                    <label class="text-caption text-text-secondary mb-1 block">Refund amount (blank = full refund)</label>
                    <input @bind="_refundAmount" type="number" step="0.01" class="w-full border border-border-base rounded-btn px-3 py-2 text-sm" placeholder="@_refundTarget.Amount.ToString("N0")" />
                </div>
                <div>
                    <label class="text-caption text-text-secondary mb-1 block">Reason (sent to Razorpay notes)</label>
                    <textarea @bind="_refundReason" rows="3" class="w-full border border-border-base rounded-btn px-3 py-2 text-sm"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_refundError))
                {
                    <div class="text-sm text-status-danger bg-status-danger/10 rounded-btn p-2">@_refundError</div>
                }
            </div>
            <div class="px-5 py-3 border-t border-border-base flex justify-end gap-2">
                <button @onclick="CancelRefund" class="btn-outline text-sm">@L["Cancel"]</button>
                <button @onclick="ConfirmRefundAsync" disabled="@_refunding" class="btn-primary text-sm">
                    @(_refunding ? "Refunding…" : "Confirm refund")
                </button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="fixed bottom-6 right-6 bg-status-success text-white px-4 py-2 rounded-btn shadow-card-hover">@_toast</div>
}

@code {
    private PagedResult<PaymentSummaryDto>? _data;
    private string _status = "";
    private string? _toast;

    private PaymentSummaryDto? _refundTarget;
    private decimal? _refundAmount;
    private string? _refundReason;
    private bool _refunding;
    private string? _refundError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        _data = await PayApi.GetPaymentsAsync(pageSize: 50, status: string.IsNullOrEmpty(_status) ? null : _status);

    private void OpenRefund(PaymentSummaryDto p)
    {
        _refundTarget = p;
        _refundAmount = null;
        _refundReason = null;
        _refundError = null;
    }

    private void CancelRefund() => _refundTarget = null;

    private async Task ConfirmRefundAsync()
    {
        if (_refundTarget is null) return;
        _refunding = true;
        _refundError = null;

        var resp = await PayApi.RefundAsync(_refundTarget.Id, new RefundPaymentRequest
        {
            Amount = _refundAmount,
            Reason = _refundReason
        });
        _refunding = false;

        if (resp?.Success == true)
        {
            _toast = "Refund submitted. Final status will arrive via webhook.";
            _refundTarget = null;
            await LoadAsync();
            _ = HideToastAsync();
        }
        else
        {
            _refundError = resp?.Message ?? "Refund failed.";
        }
    }

    private async Task HideToastAsync()
    {
        await Task.Delay(3500);
        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    private static string StatusPillClass(string status) => "pill " + status switch
    {
        "Captured"   => "bg-status-success/15 text-status-success",
        "Created"    => "bg-status-warning/15 text-status-warning",
        "Authorized" => "bg-status-info/15 text-status-info",
        "Failed"     => "bg-status-danger/15 text-status-danger",
        "Refunded"   => "bg-status-purple/15 text-status-purple",
        _            => "bg-surface-muted text-text-secondary"
    };
}
