@page "/student/assignments/{Id:guid}"
@layout StudentLayout
@inject StudentApiClient StudentApi
@inject NavigationManager Nav

<PageTitle>Assignment · NextGen</PageTitle>

@if (_data is null)
{
    <div class="card p-8 text-center text-text-muted">@L["Loading…"]</div>
}
else
{
    <div class="flex items-center gap-2 text-caption text-text-secondary mb-2">
        <a href="/student/assignments" class="text-brand-primary">← All assignments</a>
        <span>·</span><span>@_data.CourseTitle</span>
        @if (!string.IsNullOrEmpty(_data.ToolName))
        {
            <span>·</span><span>@_data.ToolName</span>
        }
    </div>

    <div class="flex items-start justify-between mb-6">
        <div>
            <div class="text-meta text-text-muted uppercase tracking-wider">Assignment #@_data.AssignmentNumber</div>
            <h1 class="text-h2">@_data.Title</h1>
            <p class="text-caption text-text-secondary mt-1">
                Due @_data.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy") · Max score @_data.MaxScore
            </p>
        </div>
        <span class="@StatusPillClass(_data.Status)">@StatusLabel(_data.Status)</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        @* ---------- Brief + resources ---------- *@
        <div class="card p-6 lg:col-span-2">
            <h2 class="text-h3 mb-3">Brief</h2>
            <div class="prose-content text-sm text-text-primary whitespace-pre-wrap">@_data.Description</div>

            @if (!string.IsNullOrEmpty(_data.ResourcesUrl))
            {
                <div class="mt-4">
                    <a href="@_data.ResourcesUrl" target="_blank" class="text-sm text-brand-primary">📎 Resources / starter files →</a>
                </div>
            }
        </div>

        @* ---------- Submission panel ---------- *@
        <div class="card p-6">
            @if (_data.Status == "Graded")
            {
                <h2 class="text-h3 mb-2">Result</h2>
                <div class="text-h2 text-status-success mb-1">@_data.Score?.ToString("0.#") / @_data.MaxScore</div>
                <div class="text-meta text-text-muted">Submitted @_data.SubmittedAtUtc?.ToLocalTime().ToString("dd MMM HH:mm")</div>

                @if (!string.IsNullOrEmpty(_data.Feedback))
                {
                    <div class="mt-4 p-3 bg-surface-muted rounded-btn">
                        <div class="text-meta text-text-muted uppercase tracking-wider mb-1">Feedback</div>
                        <p class="text-sm text-text-primary whitespace-pre-wrap">@_data.Feedback</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_data.SubmissionUrl))
                {
                    <a href="@_data.SubmissionUrl" target="_blank" class="text-sm text-brand-primary mt-3 block">View your submission →</a>
                }
            }
            else if (_data.EnrollmentId is null)
            {
                <div class="text-sm text-text-muted">You're not enrolled in this course, so you can't submit.</div>
            }
            else
            {
                <h2 class="text-h3 mb-3">@(_data.Status == "Submitted" ? "Resubmit" : "Submit")</h2>

                <div class="space-y-3">
                    <div>
                        <label class="text-caption text-text-secondary mb-1 block">Submission URL</label>
                        <input @bind="_form.SubmissionUrl" placeholder="https://github.com/you/assignment-N"
                               class="w-full border border-border-base rounded-btn px-3 py-2 text-sm" />
                        <div class="text-meta text-text-muted mt-1">GitHub repo, Google Drive link, or any public URL.</div>
                    </div>
                    <div>
                        <label class="text-caption text-text-secondary mb-1 block">Notes (optional)</label>
                        <textarea @bind="_form.SubmissionText" rows="4" placeholder="Anything you'd like the reviewer to know"
                                  class="w-full border border-border-base rounded-btn px-3 py-2 text-sm"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="text-sm text-status-danger bg-status-danger/10 rounded-btn p-2">@_error</div>
                    }
                    @if (!string.IsNullOrEmpty(_toast))
                    {
                        <div class="text-sm text-status-success bg-status-success/10 rounded-btn p-2">@_toast</div>
                    }

                    <button @onclick="SubmitAsync" disabled="@(_busy || !CanSubmit)" class="btn-primary w-full text-sm">
                        @(_busy ? "Submitting…" : (_data.Status == "Submitted" ? "Resubmit" : "Submit"))
                    </button>

                    @if (_data.Status == "Submitted" && _data.SubmittedAtUtc.HasValue)
                    {
                        <div class="text-meta text-text-muted text-center">
                            Last submitted @_data.SubmittedAtUtc.Value.ToLocalTime().ToString("dd MMM HH:mm")
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AssignmentDetailDto? _data;
    private readonly SubmitAssignmentRequest _form = new();
    private bool _busy;
    private string? _error;
    private string? _toast;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_form.SubmissionUrl)
        || !string.IsNullOrWhiteSpace(_form.SubmissionText);

    protected override async Task OnParametersSetAsync()
    {
        _data = await StudentApi.GetAssignmentAsync(Id);
        if (_data is not null)
        {
            _form.SubmissionUrl = _data.SubmissionUrl;
            _form.SubmissionText = _data.SubmissionText;
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _toast = null;

        var resp = await StudentApi.SubmitAssignmentAsync(Id, _form);
        _busy = false;

        if (resp?.Success == true)
        {
            _toast = "Submitted. You can keep editing until your instructor grades it.";
            _data = await StudentApi.GetAssignmentAsync(Id);
        }
        else
        {
            _error = resp?.Message ?? "Could not submit.";
        }
    }

    private static string StatusPillClass(string status) => "pill " + status switch
    {
        "NotStarted"  => "bg-status-warning/15 text-status-warning",
        "Submitted"   => "bg-status-info/15 text-status-info",
        "Graded"      => "bg-status-success/15 text-status-success",
        _             => "bg-surface-muted text-text-secondary"
    };

    private static string StatusLabel(string status) => status switch
    {
        "NotStarted"  => "Not started",
        _             => status
    };
}
