@page "/enroll"
@page "/checkout"
@inject CourseApiClient CoursesApi
@inject LeadApiClient Leads

<PageTitle>@L["Enrollment Form · NextGen"]</PageTitle>

<div class="enroll-page">
    <div class="ng-container enroll-heading">
        <a href="/courses" class="enroll-back">← @L["Back to courses"]</a>
        <span class="eyebrow">@L["NEXTGEN · YOUR NEXT CHAPTER"]</span>
        <h1>@L["Let's get you started."]</h1>
        <p>@L["Share your details and our admissions team will help you take the next step."]</p>
    </div>
    @if (!_loaded)
    {
        <div class="ng-container enroll-loading" role="status">@L["Loading…"]</div>
    }
    else if (_invalidCourse)
    {
        <section class="ng-container enroll-unavailable"><h2>@L["Program not found"]</h2><p>@L["Please select an available program."]</p><a href="/courses" class="btn-primary">@L["Explore all programs"]</a></section>
    }
    else
    {
        <div class="ng-container enroll-layout">
            <aside class="enroll-summary" aria-label="@L["Your selected program"]">
                <CourseIllustration CourseSlug="@(_selectedCourse?.Slug ?? "data-science")" />
                <div class="enroll-summary-body">
                    <span class="eyebrow">@L["YOUR LEARNING JOURNEY"]</span>
                    <h2>@L[_selectedCourse?.Title ?? "Choose your program"]</h2>
                    <p>@L[_selectedCourse?.Tagline ?? "Find the program that fits your interests and goals."]</p>
                    <div class="enroll-benefits"><span><ContactGlyph Name="cloud" />@L["Online · Pan India"]</span><span><ContactGlyph Name="book" />@L["Practical skills"]</span></div>
                    <div class="enroll-next"><strong>@L["What happens next?"]</strong><ol><li><span>01</span>@L["Share your details"]</li><li><span>02</span>@L["Connect with admissions"]</li><li><span>03</span>@L["Plan your learning journey"]</li></ol></div>
                </div>
            </aside>
            <section class="enroll-form-panel" aria-labelledby="enroll-form-title">
                @if (_success)
                {
                    <div class="enroll-success" role="status" tabindex="-1">
                        <span class="enroll-success-icon" aria-hidden="true">✓</span>
                        <h2 id="enroll-form-title">@L["Enrollment request received!"]</h2>
                        <p>@L.Format("Our admissions team will contact you about {0}.", L[_submittedTitle])</p>
                        <a href="/courses" class="btn-primary">@L["Explore all programs"]</a>
                    </div>
                }
                else
                {
                    <h2 id="enroll-form-title">@L["Enrollment form"]</h2>
                    <p class="enroll-form-intro">@L["Tell us a little about yourself."]</p>
                    <form @onsubmit="Submit" @onsubmit:preventDefault aria-busy="@_submitting.ToString().ToLowerInvariant()">
                        <fieldset disabled="@_submitting" class="enroll-fields">
                            <div class="enroll-field"><label for="enroll-course">@L["Program of interest"] <span>*</span></label><select id="enroll-course" name="course" required @bind="_selectedSlug"><option value="">@L["Choose your program"]</option>@foreach (var program in _courses) { <option value="@program.Slug">@L[program.Title]</option> }</select></div>
                            <div class="enroll-field"><label for="enroll-name">@L["Full Name *"]</label><input id="enroll-name" name="name" autocomplete="name" required maxlength="150" @bind="_name" @bind:event="oninput" placeholder="@L["e.g. Priya Sharma"]" /></div>
                            <div class="enroll-field"><label for="enroll-email">@L["Email Address *"]</label><input id="enroll-email" name="email" type="email" autocomplete="email" required maxlength="256" @bind="_email" @bind:event="oninput" placeholder="you@example.com" /></div>
                            <div class="enroll-form-row">
                                <div class="enroll-field"><label for="enroll-phone">@L["WhatsApp Phone *"]</label><input id="enroll-phone" name="phone" type="tel" autocomplete="tel" required maxlength="20" @bind="_phone" @bind:event="oninput" placeholder="+91 98765 43210" /></div>
                                <div class="enroll-field"><label for="enroll-city">@L["City / Location"]</label><input id="enroll-city" name="city" autocomplete="address-level2" maxlength="100" @bind="_city" @bind:event="oninput" placeholder="@L["e.g. Bengaluru"]" /></div>
                            </div>
                            <div class="enroll-field"><label for="enroll-background">@L["Graduation / Background"]</label><input id="enroll-background" name="background" maxlength="150" @bind="_background" @bind:event="oninput" placeholder="@L["e.g. B.Com 2024 / Working"]" /></div>
                            <div class="enroll-field"><label for="enroll-message">@L["Anything you'd like us to know?"]</label><textarea id="enroll-message" name="message" rows="3" maxlength="1000" @bind="_message" @bind:event="oninput" placeholder="@L["Tell us about your learning goals or questions."]"></textarea></div>
                            <button type="submit" class="btn-primary enroll-submit" disabled="@(!CanSubmit || _submitting)">@L[_submitting ? "Saving your request..." : "Submit enrollment request"]<ContactGlyph Name="arrow" /></button>
                        </fieldset>
                        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="enroll-error" role="alert">@L[_error]</div> }
                        <p class="enroll-privacy">@L["We respect your privacy. We will use your details to respond to this request."]</p>
                    </form>
                }
            </section>
        </div>
    }
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public string? Course { get; set; }
    private IReadOnlyList<CourseSummaryDto> _courses = Array.Empty<CourseSummaryDto>();
    private string _selectedSlug = "", _name = "", _email = "", _phone = "", _city = "", _background = "", _message = "", _submittedTitle = "";
    private string? _lastCourse, _error;
    private bool _loaded, _parametersApplied, _invalidCourse, _submitting, _success;
    private CourseSummaryDto? _selectedCourse => _courses.FirstOrDefault(c => string.Equals(c.Slug, _selectedSlug, StringComparison.OrdinalIgnoreCase));
    private bool CanSubmit => _selectedCourse is not null && !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_email) && !string.IsNullOrWhiteSpace(_phone);

    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded)
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            _courses = await CoursesApi.GetCoursesAsync(ct: timeout.Token) ?? Array.Empty<CourseSummaryDto>();
            _loaded = true;
        }
        if (!_parametersApplied || !string.Equals(_lastCourse, Course, StringComparison.OrdinalIgnoreCase))
        {
            _lastCourse = Course;
            _selectedSlug = Course?.Trim() ?? "";
            _invalidCourse = !string.IsNullOrEmpty(_selectedSlug) && _selectedCourse is null;
            _success = false; _error = null; _parametersApplied = true;
        }
    }

    private async Task Submit()
    {
        if (_submitting || _success || !CanSubmit || _selectedCourse is not { } selected) return;
        _submitting = true; _error = null;
        try
        {
            var subject = $"Enrollment request: {selected.Title}";
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var response = await Leads.CreateEnquiryAsync(new CreateEnquiryRequest
            {
                Name = _name.Trim(), Email = _email.Trim(), Phone = _phone.Trim(),
                Subject = subject[..Math.Min(subject.Length, 200)], SourcePage = "/enroll",
                CourseInterestId = selected.Id, City = _city.Trim(), Graduation = _background.Trim(),
                Message = $"Enrollment request for {selected.Title} ({selected.Slug}).\nCity: {_city.Trim()}\nBackground: {_background.Trim()}\nLearning goals or questions: {_message.Trim()}"
            }, timeout.Token);
            _success = response?.Success == true;
            if (_success) _submittedTitle = selected.Title;
            else _error = response?.Message ?? "We couldn’t send your enquiry. Please try again or contact us directly.";
        }
        finally { _submitting = false; }
    }
}
