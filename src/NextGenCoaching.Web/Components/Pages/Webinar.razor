@page "/webinar"
@inject WebinarApiClient Webinars
@inject LeadApiClient Leads

<PageTitle>@L["Live Career Masterclass & Free Webinar · NextGen IT Coaching"]</PageTitle>

<div class="masterclass-page">
    <section class="mc-hero" aria-labelledby="masterclass-title">
        <div class="ng-container mc-hero-grid">
            <div class="mc-hero-copy" data-motion="fade-up">
                <span class="mc-eyebrow"><span class="mc-dot"></span>@L["A FREE LIVE MASTERCLASS"]</span>
                <h1 id="masterclass-title">@L["Big ideas."] <span>@L["Bright beginnings."]</span></h1>
                <p>@L["Meet your mentors, explore Data Science, AI and cloud, and discover what your next chapter could look like."]</p>
                <a class="mc-primary" href="/webinar#masterclass-registration">@L[NoScheduledSessions ? "Get the next session update" : "Find your masterclass"] <ContactGlyph Name="arrow" /></a>
                <div class="mc-hero-facts">
                    <span><ContactGlyph Name="cloud" />@L["Online · Pan India"]</span>
                    <span><ContactGlyph Name="chat" />@L["Ask your questions"]</span>
                </div>
            </div>
            <MasterclassCollage />
        </div>
        <div class="ng-container mc-topic-strip" aria-label="@L["Explore your next chapter"]">
            <span class="mc-topic-intro">@L["A little curiosity goes a long way."]</span>
            <div><span>Data Science</span><b aria-hidden="true">✦</b><span>AI</span><b aria-hidden="true">✦</b><span>SQL</span><b aria-hidden="true">✦</b><span>Cloud</span></div>
        </div>
    </section>

    <section id="masterclass-registration" class="ng-container mc-registration" aria-labelledby="mc-registration-title">
        <div class="mc-discover">
            <span class="mc-eyebrow">@L["YOUR FIRST STEP STARTS HERE"]</span>
            <h2>@L["Get a feel for your future."]</h2>
            <p class="mc-section-description">@L["See how we teach, understand the learning path, and bring the questions that matter to you."]</p>
            <div class="mc-discovery-list">
                <div><span class="mc-feature-icon mc-feature-icon--blue"><ContactGlyph Name="book" /></span><div><h3>@L["Explore the learning path"]</h3><p>@L["Discover the skills, projects and program options for your goals."]</p></div></div>
                <div><span class="mc-feature-icon mc-feature-icon--coral"><ContactGlyph Name="code" /></span><div><h3>@L["Experience our teaching"]</h3><p>@L["Get a practical introduction to learning with NextGen."]</p></div></div>
                <div><span class="mc-feature-icon mc-feature-icon--lime"><ContactGlyph Name="chat" /></span><div><h3>@L["Make room for your questions"]</h3><p>@L["Talk about your background, interests and next career move."]</p></div></div>
            </div>
            <div class="mc-session-area">
                <div class="mc-session-heading"><span class="mc-step">01</span><h3>@L["Select an Upcoming Session"]</h3></div>
                @if (_upcoming is null)
                {
                    <p role="status" class="mc-session-empty">@L["Fetching upcoming live sessions…"]</p>
                }
                else if (NoScheduledSessions)
                {
                    <div class="mc-session-empty"><ContactGlyph Name="book" /><div><strong>@L["New sessions are on the way."]</strong><p>@L["Share your details to hear when the next online masterclass is scheduled."]</p></div></div>
                }
                else
                {
                    <div class="mc-session-list" role="group" aria-label="@L["Select an Upcoming Session"]">
                        @foreach (var w in _upcoming)
                        {
                            var selected = w.Id == _selectedWebinarId;
                            <button type="button" @onclick="() => Select(w.Id)" class="mc-session @(selected ? "is-selected" : "")" aria-pressed="@selected.ToString().ToLowerInvariant()">
                                <span class="mc-session-title">@L[w.Title]<span class="mc-session-check" aria-hidden="true">@(selected ? "✓" : "+")</span></span>
                                <span>@w.ScheduledAtUtc.ToLocalTime().ToString("ddd, dd MMM yyyy · hh:mm tt", L.Culture)</span>
                                <small>@L.Format("{0} Mins", w.DurationMinutes) @if (!string.IsNullOrEmpty(w.CourseTitle)) { <span>· @L[w.CourseTitle]</span> }</small>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="mc-form-card">
            <div class="mc-form-top"><span class="mc-step">02</span><span>@L["LET'S FIND YOUR NEXT CHAPTER"]</span><ContactGlyph Name="spark" /></div>
            <div class="mc-form-body">
                <h2 id="mc-registration-title">@L[NoScheduledSessions ? "Get the next masterclass update" : "Confirm Your Free Registration"]</h2>
                <p>@L[NoScheduledSessions ? "Leave your details and our team will contact you when a new online session is scheduled." : "Enter your details to receive the private Zoom link and preparation notes."]</p>
                <form @onsubmit="Submit" @onsubmit:preventDefault>
                    <div class="mc-field"><label for="mc-name">@L["Full Name *"]</label><input id="mc-name" name="name" autocomplete="name" required maxlength="150" @bind="_req.FullName" @bind:event="oninput" placeholder="@L["e.g. Priya Sharma"]" /></div>
                    <div class="mc-field"><label for="mc-email">@L["Email Address *"]</label><input id="mc-email" name="email" autocomplete="email" type="email" required maxlength="256" @bind="_req.Email" @bind:event="oninput" placeholder="priya@example.com" /></div>
                    <div class="mc-form-row">
                        <div class="mc-field"><label for="mc-phone">@L["WhatsApp Phone *"]</label><input id="mc-phone" name="phone" autocomplete="tel" type="tel" required maxlength="20" @bind="_req.Phone" @bind:event="oninput" placeholder="+91 98765 43210" /></div>
                        <div class="mc-field"><label for="mc-city">@L["City / Location"]</label><input id="mc-city" name="city" autocomplete="address-level2" maxlength="100" @bind="_req.City" @bind:event="oninput" placeholder="@L["e.g. Bengaluru"]" /></div>
                    </div>
                    <div class="mc-field"><label for="mc-background">@L["Graduation / Background"]</label><input id="mc-background" name="background" maxlength="150" @bind="_req.Graduation" @bind:event="oninput" placeholder="@L["e.g. B.Com 2024 / Working"]" /></div>
                    <button type="submit" class="mc-primary mc-submit" disabled="@(!CanSubmit || _submitting)">@L[_submitting ? "Saving your request..." : NoScheduledSessions ? "Notify me about the next session →" : "Claim Your Free Masterclass Seat →"]</button>
                    @if (!string.IsNullOrEmpty(_resultMessage))
                    {
                        <div class="mc-result @(_success ? "mc-result--success" : "mc-result--error")" role="status">@L[_resultMessage]</div>
                    }
                    <p class="mc-privacy">@L["We respect your privacy. We will use your details to respond to this request."]</p>
                </form>
            </div>
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<WebinarDto>? _upcoming;
    private Guid? _selectedWebinarId;
    private readonly RegisterWebinarRequest _req = new();
    private string? _resultMessage;
    private bool _submitting;
    private bool _success;

    private bool NoScheduledSessions => _upcoming is { Count: 0 };
    private bool CanSubmit =>
        !_success && (_selectedWebinarId.HasValue || NoScheduledSessions)
        && !string.IsNullOrWhiteSpace(_req.FullName)
        && !string.IsNullOrWhiteSpace(_req.Email)
        && !string.IsNullOrWhiteSpace(_req.Phone);

    private string ResultClass => _success
        ? "text-xs text-status-success bg-status-success/10 rounded-xl p-3 border border-status-success/20"
        : "text-xs text-status-danger bg-status-danger/10 rounded-xl p-3 border border-status-danger/20";

    protected override async Task OnInitializedAsync()
    {
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
        _upcoming = await Webinars.GetUpcomingAsync(10, timeout.Token) ?? Array.Empty<WebinarDto>();
        if (_upcoming is { Count: > 0 })
            _selectedWebinarId = _upcoming[0].Id;
    }

    private void Select(Guid id) => _selectedWebinarId = id;

    private async Task Submit()
    {
        if (_submitting || !CanSubmit) return;
        _submitting = true;
        _resultMessage = null;

        var resp = _selectedWebinarId.HasValue
            ? await Webinars.RegisterAsync(_selectedWebinarId.Value, _req)
            : await Leads.CreateEnquiryAsync(new CreateEnquiryRequest
            {
                Name = _req.FullName, Email = _req.Email, Phone = _req.Phone,
                Subject = "Next masterclass interest", SourcePage = "/webinar",
                Message = $"Please contact me when the next online masterclass is scheduled. City: {_req.City}. Background: {_req.Graduation}."
            });
        _submitting = false;
        _success = resp?.Success ?? false;
        _resultMessage = _success && NoScheduledSessions
            ? "Your interest is saved. Our team will contact you about the next online session."
            : resp?.Message ?? "Something went wrong. Please check your details and try again.";
    }
}

