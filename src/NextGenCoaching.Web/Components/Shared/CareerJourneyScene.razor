<div class="career-journey-scene" data-career-journey role="group" aria-label="@L["Your journey from learning data skills to building a brighter career"]">
    <div class="journey-scene-aura" aria-hidden="true"></div>
    <div class="journey-scene-seal" aria-hidden="true"><span>✦</span><small>@L["Learn. Build. Grow."]</small></div>
    <div class="journey-scene-stage" aria-hidden="true">
        <ResponsiveImage Source="/images/career-journey.webp" Width="1254" Height="1254" Alt="" Priority="true" />
        <svg class="journey-scene-flow" viewBox="0 0 1000 1000" fill="none">
            <defs>
                <filter id="journey-soft-glow" x="-150%" y="-150%" width="400%" height="400%"><feGaussianBlur stdDeviation="5" /></filter>
                <radialGradient id="journey-ai-light"><stop stop-color="#ffe7a6" stop-opacity=".6" /><stop offset="1" stop-color="#ff886b" stop-opacity="0" /></radialGradient>
                <radialGradient id="journey-gold-light"><stop stop-color="#fff4ad" stop-opacity=".55" /><stop offset="1" stop-color="#e6ff91" stop-opacity="0" /></radialGradient>
            </defs>
            <path data-journey-input d="M355 741C421 718 399 641 464 630C573 611 739 642 780 562C817 499 658 468 628 472" stroke="#72eaff" stroke-opacity=".5" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round" />
            <path data-journey-output d="M666 416C770 428 896 416 934 346C977 264 811 245 819 200" stroke="#fff2a1" stroke-opacity=".6" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round" />
            <g data-journey-input-packet opacity="0"><circle r="12" fill="#70efff" filter="url(#journey-soft-glow)"/><circle r="4" fill="white"/></g>
            <g data-journey-input-packet opacity="0"><circle r="12" fill="#70efff" filter="url(#journey-soft-glow)"/><circle r="4" fill="white"/></g>
            <g data-journey-input-packet opacity="0"><circle r="12" fill="#70efff" filter="url(#journey-soft-glow)"/><circle r="4" fill="white"/></g>
            <ellipse data-journey-ai-glow cx="613" cy="414" rx="116" ry="125" fill="url(#journey-ai-light)" opacity="0" />
            <rect data-journey-ai-ring x="568" y="363" width="95" height="108" rx="16" stroke="#fff0b5" stroke-width="3" opacity="0" />
            <g data-journey-output-packet opacity="0"><circle r="13" fill="#fff0a5" filter="url(#journey-soft-glow)"/><circle r="4.5" fill="#fffde7"/></g>
            <g data-journey-output-packet opacity="0"><circle r="13" fill="#fff0a5" filter="url(#journey-soft-glow)"/><circle r="4.5" fill="#fffde7"/></g>
            <g data-journey-climber opacity="0"><circle r="18" fill="#285bff" stroke="#d5eeff" stroke-width="2"/><path d="M-6 5 0-5 6 5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></g>
            <ellipse data-journey-achievement-glow cx="822" cy="186" rx="109" ry="121" fill="url(#journey-gold-light)" opacity="0" />
            <circle data-journey-achievement-ring cx="822" cy="186" r="63" stroke="#fff3ad" stroke-width="3" opacity="0" />
            <circle data-journey-mentor-ring cx="377" cy="337" r="30" stroke="#f9e39e" stroke-width="2" opacity="0" />
            <g data-journey-sparkle="0"><path d="M0-6V6M-6 0H6" stroke="#a5c2ff" stroke-width="2" stroke-linecap="round"/></g>
            <g data-journey-sparkle="1"><path d="M0-6V6M-6 0H6" stroke="#ffa47b" stroke-width="2" stroke-linecap="round"/></g>
            <g data-journey-sparkle="2"><path d="M0-6V6M-6 0H6" stroke="#a6cb60" stroke-width="2" stroke-linecap="round"/></g>
            <g data-journey-sparkle="3"><path d="M0-6V6M-6 0H6" stroke="#b7a3fa" stroke-width="2" stroke-linecap="round"/></g>
            <g data-journey-sparkle="4"><path d="M0-6V6M-6 0H6" stroke="#89baff" stroke-width="2" stroke-linecap="round"/></g>
        </svg>
    </div>
    <div class="journey-scene-footer">
        <ol class="journey-scene-steps" aria-label="@L["Learn. Build. Grow."]"><li data-journey-step="learn"><span>01</span> @L["Learn with mentors"]</li><li data-journey-step="build"><span>02</span> @L["Build with AI"]</li><li data-journey-step="grow"><span>03</span> @L["Grow your career"]</li></ol>
        <button type="button" class="journey-motion-toggle" data-journey-toggle aria-pressed="false" data-pause-label="@L["Pause animation"]" data-play-label="@L["Play animation"]" aria-label="@L["Pause animation"]"><span data-journey-toggle-icon aria-hidden="true">Ⅱ</span><span class="sr-only" data-journey-toggle-label>@L["Pause animation"]</span></button>
    </div>
</div>
