@implements IDisposable
<div class="site-preferences" role="group" aria-label="@L["Appearance and language"]">
    <button type="button" class="theme-toggle" @onclick="L.ToggleThemeAsync" aria-label="@L[L.Theme == "dark" ? "Switch to light mode" : "Switch to dark mode"]" title="@L[L.Theme == "dark" ? "Switch to light mode" : "Switch to dark mode"]" aria-pressed="@(L.Theme == "dark" ? "true" : "false")">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            @if (L.Theme == "dark")
            {
                <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            }
            else
            {
                <path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" />
            }
        </svg>
    </button>
    <label class="language-picker"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z" /></svg><span class="sr-only">@L["Select language"]</span><select aria-label="@L["Select language"]" value="@L.Language" @onchange="ChangeLanguageAsync"><option value="en" lang="en">English</option><option value="mr" lang="mr">मराठी</option><option value="hi" lang="hi">हिन्दी</option></select></label>
</div>
@code {
    protected override void OnInitialized() => L.ThemeChanged += OnThemeChanged;
    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.ThemeChanged -= OnThemeChanged;
    private Task ChangeLanguageAsync(ChangeEventArgs e) => L.SetLanguageAsync(e.Value?.ToString());
}
