@inject NavigationManager Nav
@implements IDisposable

<aside class="hidden md:flex md:flex-col w-60 bg-brand-navy text-brand-sky-100 min-h-screen sticky top-0">
    <div class="px-5 py-5 flex items-center gap-2 border-b border-brand-navy-light">
        <BrandLogo Class="official-logo--portal" />
        <div class="leading-tight">
            <div class="text-white font-semibold text-sm">NextGen</div>
            <div class="text-meta text-brand-sky-200 uppercase tracking-wider">@L["HR · Placements"]</div>
        </div>
    </div>

    <nav class="flex-1 px-3 py-4 space-y-0.5 text-sm">
        @foreach (var item in _nav)
        {
            <a href="@item.Href" class="@LinkClass(item.Href) flex items-center gap-3 px-3 py-2 rounded-btn">
                <span class="w-5 h-5 flex items-center justify-center">@item.Icon</span>
                <span>@L[item.Label]</span>
            </a>
        }
    </nav>

    <div class="px-3 py-4 border-t border-brand-navy-light text-meta text-brand-sky-200">
        <a href="/" class="hover:text-white">@L["← Back to site"]</a>
    </div>
</aside>

@code {
    private record NavItem(string Label, string Href, string Icon);

    private readonly NavItem[] _nav =
    {
        new("Dashboard",   "/hr",            "▣"),
        new("Resumes",     "/hr/resumes",    "📄"),
        new("Jobs",        "/hr/jobs",       "💼"),
        new("Referrals",   "/hr/referrals",  "🤝"),
        new("My profile",  "/hr/profile",    "👤")
    };

    private string LinkClass(string href)
    {
        var current = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var target = href.TrimEnd('/');
        var isActive = current == target || (target != "/hr" && current.StartsWith(target + "/"));
        return isActive
            ? "bg-brand-primary text-white"
            : "text-brand-sky-100 hover:bg-brand-navy-light hover:text-white";
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
}

