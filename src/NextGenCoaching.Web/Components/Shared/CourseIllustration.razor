@code {
    [Parameter] public string CourseSlug { get; set; } = string.Empty;
    [Parameter] public string ImageSizes { get; set; } = "(max-width: 639px) calc(100vw - 32px), (max-width: 1023px) 45vw, 400px";

    private string Description => CourseSlug switch
    {
        "data-science" => "A friendly AI robot exploring charts and a neural network",
        "sql" => "A smiling database connecting tables and organizing data",
        "python" => "A playful Python snake coding beside an automation laptop",
        "power-bi" => "A cartoon analyst presenting colorful dashboard charts",
        "snowflake" => "A cheerful cloud connecting a snowflake, data tables, and a warehouse",
        "azure-data-factory" => "A smiling cloud factory moving data along a pipeline",
        "advanced-ai" => "A friendly AI chip connected to a neural network, a vision tool and a data cube",
        "machine-learning" => "A pastel learning-model laptop turns a data table into a prediction chart",
        "generative-ai" => "A smiling generative AI companion creates a picture and code from a prompt",
        "agentic-ai" => "A friendly agent coordinates search, data, tools and completed tasks",
        "databricks" => "A smiling bronze, silver and gold lakehouse connects data tables to the cloud",
        _ => "A friendly learning companion"
    };
}
