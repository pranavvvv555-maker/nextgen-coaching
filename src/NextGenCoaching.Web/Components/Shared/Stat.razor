@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Trend { get; set; }
}

<div data-tilt class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-5 hover:bg-white/15 transition-all duration-300 shadow-lg shadow-black/10 group">
    <div class="flex items-center justify-between mb-2">
        <div class="text-2xl md:text-3xl font-extrabold text-white tracking-tight group-hover:scale-105 transition-transform">
            @Value
        </div>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="text-2xl p-2 rounded-xl bg-white/10">@Icon</span>
        }
    </div>
    <div class="flex items-center justify-between">
        <div class="text-xs font-medium text-brand-sky-100">@L[Label]</div>
        @if (!string.IsNullOrEmpty(Trend))
        {
            <span class="text-[10px] font-bold text-emerald-300 bg-emerald-500/20 px-1.5 py-0.5 rounded-full">
                @Trend
            </span>
        }
    </div>
</div>
