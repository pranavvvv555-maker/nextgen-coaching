@inherits LocalizedLayoutBase
@inject AuthStateService AuthState
@implements IDisposable

@if (!AuthState.Initialized)
{
    @* Session restore from browser storage is in flight (see AuthSessionRestore) — don't
       flash the sign-in prompt at users who are about to be signed back in. *@
    <div class="min-h-screen flex items-center justify-center bg-surface-muted">
        <p class="text-text-secondary animate-pulse">@L["Loading…"]</p>
    </div>
}
else if (!AuthState.IsAuthenticated)
{
    <div class="min-h-screen flex items-center justify-center bg-surface-muted">
        <div class="text-center">
            <div class="flex justify-center mb-6"><BrandLogo /></div>
            <p class="text-text-secondary mb-4">@L["You need to sign in to view your instructor portal."]</p>
            <a href="/login" class="btn-primary">@L["Go to sign-in"]</a>
        </div>
    </div>
}
else if (!AuthState.IsInRole(RoleNames.Instructor) && !AuthState.IsInRole(RoleNames.Admin))
{
    <PortalAccessDenied />
}
else
{
    <div class="workspace-shell min-h-screen flex bg-surface-muted">
        <InstructorSidebar />
        <div class="flex-1 flex flex-col min-w-0">
            <InstructorTopBar />
            <PortalMobileNav />
            <main class="flex-1 px-6 py-6 overflow-x-auto">
                @Body
            </main>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => AuthState.StateChanged += OnAuthChanged;
    private void OnAuthChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => AuthState.StateChanged -= OnAuthChanged;
}

